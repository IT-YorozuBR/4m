MONGODB_URI=mongodb://localhost:27017/4m_checklist
PORT=3001
JWT_SECRET=troque-esta-chave-por-uma-segura
PUBLIC_API_BASE_URL=
PUBLIC_API_URL=
CORS_ORIGINS=

# ──────────────────────────────────────────────────────────────────────
# DOCKER COMPOSE (produção)
# Usadas apenas pelo docker-compose.yml para subir o MongoDB junto com a
# aplicação. MONGODB_URI e PORT acima são sobrescritas automaticamente
# pelo compose (não precisa editá-las para rodar via Docker).
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=troque-esta-senha-por-uma-segura

# ──────────────────────────────────────────────────────────────────────
# USUÁRIOS (semeados no startup a partir destas variáveis)
# Para cada usuário defina: USER_<NOME>, USER_<NOME>_PASSWORD e (opcional)
# USER_<NOME>_ROLE. Sem _ROLE, o padrão é "admin".
#
# Roles válidos (controle de acesso por etapa do fluxo FR0062):
#   operador            -> Produção (etapa 1) — não exige login
#   qualidade           -> Qualidade (etapa 2)
#   aprovador_qualidade -> Aprovação Qualidade (etapa 3)
#   admin               -> Aprovação (etapa 4) e Conclusão — acesso total
#
# Obs.: as contas das etapas "qualidade" e "aprovador.qualidade" também são
# criadas automaticamente no startup (ver garantirContasEtapas em src/server.js).
# Exemplo:
# USER_QUALIDADE=qualidade
# USER_QUALIDADE_PASSWORD=troque-esta-senha
# USER_QUALIDADE_ROLE=qualidade
